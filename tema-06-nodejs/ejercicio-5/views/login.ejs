<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <header>
      <h1><%= title %></h1>
      <a href="/">← Volver al inicio</a>
    </header>

    <main>
      <!-- method="post": los datos viajan en el cuerpo, no en la URL (tema 2).
           action="/login": se envían a la ruta router.post('/login') -->
      <form class="login" method="post" action="/login">

        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <!-- El atributo name es la "clave" con la que llega cada dato a req.body -->
        <label>Email
          <input type="email" name="email" required>
        </label>

        <label>Contraseña
          <input type="password" name="password" required>
        </label>

        <button class="boton" type="submit">Entrar</button>
        <p class="pista">Usuario de prueba: admin@ceu.es / 1234</p>
      </form>
    </main>
  </body>
</html>
